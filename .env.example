# GitHub: works without a token at 60 req/hr, which burns fast (2 calls per PR).
# A classic PAT with NO scopes is enough — this only reads public data.
GITHUB_TOKEN=

# Which LLM the worker talks to.
#   fake      — scripted replies. Used by tests and by `task demo` (deterministic).
#   ollama    — local, free, no account. The default for `docker compose up`.
#   anthropic — hosted. Faster and cleaner, needs a key.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Below this score the worker stops trusting the first answer and retries.
CONFIDENCE_THRESHOLD=0.65

POSTGRES_DSN=postgresql://triage:triage@postgres:5432/triage
REDPANDA_BROKERS=redpanda:9092
