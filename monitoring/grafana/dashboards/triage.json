  {
   "id": 20,
   "type": "timeseries",
   "title": "Details call came back empty, % per 3h",
   "description": "Share of kept answers (model, model_retry) with neither affected_area nor risk_note. The second call is best-effort and fails silently by design, so this is the only place that shows it. The label is still fine; only the note is missing. Buckets with fewer than 5 kept answers are left out.",
   "datasource": {
    "type": "postgres",
    "uid": "pg"
   },
   "gridPos": {
    "h": 9,
    "w": 6,
    "x": 18,
    "y": 25
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT\n  $__timeGroupAlias(triaged_at, '3h'),\n  100.0 * count(*) FILTER (WHERE affected_area IS NULL AND risk_note IS NULL) / count(*) AS \"empty %\"\nFROM pr_triage\nWHERE $__timeFilter(triaged_at) AND ('__all' IN ($model) OR model IN ($model)) AND label_source IN ('model', 'model_retry')\nGROUP BY 1\nHAVING count(*) >= 5\nORDER BY 1",
     "format": "time_series"
    }
   ],
