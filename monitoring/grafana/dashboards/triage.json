     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE label_source = 'model_retry')\n       / NULLIF(count(*) FILTER (WHERE label_source <> 'skipped'), 0) AS value\nFROM pr_triage\nWHERE $__timeFilter(triaged_at) AND ('__all' IN ($model) OR model IN ($model))",
     "format": "table"
    }
   ],
   "fieldConfig": {
