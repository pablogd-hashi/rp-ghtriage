  {
   "id": 14,
   "type": "timeseries",
   "title": "How each PR got its label, share per hour",
   "description": "Each bar is 100% of the rows written that hour. Red is fallback (gave up, wrote unclear), amber is model_retry (needed the stricter second prompt), green is model, grey is skipped (never asked). The last bar is a partial hour. The upsert resets triaged_at when a PR is reprocessed, so a row only counts in the bucket of its last write. A fallback that a later run fixed is gone from history.",
   "datasource": {
    "type": "postgres",
    "uid": "pg"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 0,
    "y": 15
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT\n  $__timeGroupAlias(triaged_at, '1h'),\n  label_source AS metric,\n  count(*) AS value\nFROM pr_triage\nWHERE $__timeFilter(triaged_at) AND ('__all' IN ($model) OR model IN ($model))\nGROUP BY 1, 2\nORDER BY 1",
     "format": "time_series"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 70,
      "showPoints": "auto",
      "pointSize": 5,
      "spanNulls": false,
      "stacking": {
       "mode": "percent",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "off"
      },
      "barAlignment": -1
     },
     "unit": "percentunit",
     "color": {
      "mode": "palette-classic"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "model"
      },
      "properties": [
       {
