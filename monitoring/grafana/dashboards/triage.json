  {
   "id": 17,
   "type": "barchart",
   "title": "Confidence of kept answers",
   "description": "Scores the model gave for answers we kept, in 0.05 buckets. Nothing kept can be under the gate (0.65, CONFIDENCE_THRESHOLD), so watch how much sits just above it: if the pile moves toward the gate, retries and fallbacks are about to rise. Retried answers are the score of the second attempt.",
   "datasource": {
    "type": "postgres",
    "uid": "pg"
   },
   "gridPos": {
    "h": 9,
    "w": 6,
    "x": 0,
    "y": 25
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "WITH b AS (SELECT generate_series(12, 19) AS i)\nSELECT\n  CASE WHEN b.i = 13 THEN '0.65 gate' ELSE to_char(b.i / 20.0, 'FM0.00') END AS bucket,\n  count(t.pr_url) FILTER (WHERE t.label_source = 'model') AS model,\n  count(t.pr_url) FILTER (WHERE t.label_source = 'model_retry') AS model_retry\nFROM b\nLEFT JOIN pr_triage t\n  ON LEAST(floor(t.confidence * 20 + 1e-6), 19) = b.i\n  AND t.label_source IN ('model', 'model_retry')\n  AND $__timeFilter(t.triaged_at) AND ('__all' IN ($model) OR t.model IN ($model))\nGROUP BY b.i\nORDER BY b.i",
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "fillOpacity": 70,
      "lineWidth": 1
     }
    },
    "overrides": [
