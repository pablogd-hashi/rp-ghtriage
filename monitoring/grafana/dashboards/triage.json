  {
   "id": 15,
   "type": "timeseries",
   "title": "Time per PR, by label_source (p95, 3h buckets)",
   "description": "Whole triage loop per PR, not per call: per-call averages mix the classify, retry and details calls and hide the cost of a retry. Retries should cost about 1.5x a clean answer. Fallback rows are usually timeouts, so they sit at the top. The dashed line is p50 across all model-asked PRs. Skipped rows excluded. The upsert resets triaged_at when a PR is reprocessed, so a row only counts in the bucket of its last write. A fallback that a later run fixed is gone from history.",
   "datasource": {
    "type": "postgres",
    "uid": "pg"
   },
   "gridPos": {
    "h": 9,
    "w": 12,
    "x": 12,
    "y": 15
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT\n  $__timeGroupAlias(triaged_at, '3h'),\n  label_source || ' p95' AS metric,\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY latency_ms) AS value\nFROM pr_triage\nWHERE $__timeFilter(triaged_at) AND ('__all' IN ($model) OR model IN ($model)) AND llm_calls > 0\nGROUP BY 1, 2\nUNION ALL\nSELECT\n  $__timeGroupAlias(triaged_at, '3h'),\n  'all p50' AS metric,\n  percentile_cont(0.5) WITHIN GROUP (ORDER BY latency_ms) AS value\nFROM pr_triage\nWHERE $__timeFilter(triaged_at) AND ('__all' IN ($model) OR model IN ($model)) AND llm_calls > 0\nGROUP BY 1, 2\nORDER BY 1",
     "format": "time_series"
    }
   ],
