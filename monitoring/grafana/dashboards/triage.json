  {
   "id": 19,
   "type": "timeseries",
   "title": "PR opened to triaged (p50, p95)",
   "description": "triaged_at minus event_created_at: polling delay, queue time and model time together. This is the delay a person waiting for a label sees. Log scale: GitHub also hands over PRs opened days ago, so p95 is in days while p50 is minutes. A PR that was reprocessed counts from its last write.",
   "datasource": {
    "type": "postgres",
    "uid": "pg"
   },
   "gridPos": {
    "h": 9,
    "w": 6,
    "x": 12,
    "y": 25
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT\n  $__timeGroupAlias(triaged_at, '1h'),\n  percentile_cont(0.5)  WITHIN GROUP (ORDER BY extract(epoch FROM triaged_at - event_created_at)) AS p50,\n  percentile_cont(0.95) WITHIN GROUP (ORDER BY extract(epoch FROM triaged_at - event_created_at)) AS p95\nFROM pr_triage\nWHERE $__timeFilter(triaged_at) AND ('__all' IN ($model) OR model IN ($model)) AND event_created_at IS NOT NULL\nGROUP BY 1\nORDER BY 1",
     "format": "time_series"
    }
   ],
