  {
   "id": 23,
   "type": "table",
   "title": "Latest fallbacks",
   "description": "The 50 newest fallback rows. Click a PR to open it on GitHub. Reason is the rationale the worker wrote, which carries the exception from both attempts.",
   "datasource": {
    "type": "postgres",
    "uid": "pg"
   },
   "gridPos": {
    "h": 10,
    "w": 18,
    "x": 6,
    "y": 35
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT\n  triaged_at AS \"Time\",\n  repo || '#' || pr_number AS \"PR\",\n  title AS \"Title\",\n  CASE\n    WHEN rationale LIKE 'Could not classify: model unreachable%' THEN 'model unreachable'\n    WHEN rationale LIKE 'Could not classify: unreadable answer%' THEN 'unreadable answer'\n    WHEN rationale LIKE 'Could not classify: low confidence%' THEN 'unsure, then retry failed'\n    WHEN rationale LIKE 'Could not classify: model unsure twice%' THEN 'unsure twice'\n    ELSE 'other'\n  END AS \"Kind\",\n  regexp_replace(rationale, '^Could not classify: ', '') AS \"Reason\",\n  llm_calls AS \"Calls\",\n  latency_ms AS \"Time taken\",\n  replace(replace(pr_url, 'api.github.com/repos', 'github.com'), '/pulls/', '/pull/') AS url\nFROM pr_triage\nWHERE $__timeFilter(triaged_at) AND ('__all' IN ($model) OR model IN ($model)) AND label_source = 'fallback'\nORDER BY triaged_at DESC\nLIMIT 50",
     "format": "table"
    }
   ],
