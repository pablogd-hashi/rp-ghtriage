  {
   "id": 12,
   "type": "timeseries",
   "title": "Fallback share, per 3h",
   "description": "Same as the stat above, in 3h buckets. Lines at 5% and 15%. Buckets with fewer than 5 model-asked PRs are left out, since one fallback out of two rows reads as 50%. The upsert resets triaged_at when a PR is reprocessed, so a row only counts in the bucket of its last write. A fallback that a later run fixed is gone from history.",
   "datasource": {
    "type": "postgres",
    "uid": "pg"
   },
   "gridPos": {
    "h": 8,
    "w": 8,
    "x": 16,
    "y": 6
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT\n  $__timeGroupAlias(triaged_at, '3h'),\n  100.0 * count(*) FILTER (WHERE label_source = 'fallback')\n    / count(*) AS \"fallback %\"\nFROM pr_triage\nWHERE $__timeFilter(triaged_at) AND ('__all' IN ($model) OR model IN ($model)) AND label_source <> 'skipped'\nGROUP BY 1\nHAVING count(*) >= 5\nORDER BY 1",
     "format": "time_series"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 0,
      "showPoints": "always",
      "pointSize": 5,
      "spanNulls": true,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "dashed"
      },
      "barAlignment": -1
     },
     "unit": "percent",
     "color": {
      "mode": "palette-classic"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 5
       },
       {
        "color": "red",
        "value": 15
       }
      ]
     },
     "min": 0
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "fallback %"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "red"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
