  {
   "id": 22,
   "type": "bargauge",
   "title": "Why it fell back",
   "description": "Fallback rows grouped by what went wrong on the first attempt. model unreachable is the model host (timeouts, 500s), not the prompt. unreadable answer and unsure point at the prompt or the model.",
   "datasource": {
    "type": "postgres",
    "uid": "pg"
   },
   "gridPos": {
    "h": 10,
    "w": 6,
    "x": 0,
    "y": 35
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT\n  CASE\n    WHEN rationale LIKE 'Could not classify: model unreachable%' THEN 'model unreachable'\n    WHEN rationale LIKE 'Could not classify: unreadable answer%' THEN 'unreadable answer'\n    WHEN rationale LIKE 'Could not classify: low confidence%' THEN 'unsure, then retry failed'\n    WHEN rationale LIKE 'Could not classify: model unsure twice%' THEN 'unsure twice'\n    ELSE 'other'\n  END AS reason,\n  count(*) AS value\nFROM pr_triage\nWHERE $__timeFilter(triaged_at) AND ('__all' IN ($model) OR model IN ($model)) AND label_source = 'fallback'\nGROUP BY 1\nORDER BY 2 DESC",
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "red"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
