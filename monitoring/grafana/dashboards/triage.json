  {
   "id": 3,
   "type": "stat",
   "title": "Fallback share",
   "description": "Share of PRs we asked the model about that ended as fallback (forced to unclear). Skipped rows are left out, since the model never saw them. Amber at 5%, red at 15%: a starting point, not a measured SLO.",
   "datasource": {
    "type": "postgres",
    "uid": "pg"
   },
   "gridPos": {
    "h": 4,
    "w": 4,
    "x": 3,
    "y": 1
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "pg"
     },
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE label_source = 'fallback')\n       / NULLIF(count(*) FILTER (WHERE label_source <> 'skipped'), 0) AS value\nFROM pr_triage\nWHERE $__timeFilter(triaged_at) AND ('__all' IN ($model) OR model IN ($model))",
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 5
       },
       {
        "color": "red",
        "value": 15
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "orientation": "auto"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Retry share",
   "description": "Share of model-asked PRs where the first answer was unusable or under the gate, and the stricter retry worked. Each one costs an extra call. Rising retries usually come before rising fallbacks.",
   "datasource": {
    "type": "postgres",
    "uid": "pg"
   },
   "gridPos": {
    "h": 4,
    "w": 3,
    "x": 7,
