{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/guard-shell.py",
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/require-gate.py",
        "failClosed": false
      }
    ]
  }
}
